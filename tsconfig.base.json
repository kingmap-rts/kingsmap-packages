{
  "compilerOptions": {
    "declaration": true,
    "module": "CommonJS",
    "target": "ES2020",
    "sourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "noEmitOnError": true,
    "lib": ["ES2022"],
    "types": []
  },
  "exclude": ["node_modules"]
}
