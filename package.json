{
  "name": "kingsmap-packages",
  "version": "1.0.0",
  "private": true,
  "description": "Private packages of the King's Map game shared by kingsmap-front and kingsmap-backend",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "dev": "lerna run dev --parallel",
    "clean": "lerna run clean",
    "test": "lerna run test --stream",
    "typecheck": "lerna run typecheck",
    "publish:types": "dotenv -- yarn workspace @kingmap-rts/kingsmap-types npm publish",
    "publish:protocol": "dotenv -- yarn workspace @kingmap-rts/kingsmap-protocol npm publish",
    "publish:core": "dotenv -- yarn workspace @kingmap-rts/kingsmap-core npm publish",
    "format": "prettier --write \"**/*.{js,ts,json,md,yml,yaml}\"",
    "check-formatting": "prettier -l \"**/*.{js,ts,json,md,yml,yaml}\"",
    "fix-formatting": "prettier --write \"**/*.{js,ts,json,md,yml,yaml}\"",
    "check-quality": "eslint .",
    "fix-quality": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingmap-rts/kingsmap-packages.git"
  },
  "author": "kingmap-rts",
  "license": "UNLICENSED",
  "homepage": "https://github.com/kingmap-rts/kingsmap-packages#readme",
  "bugs": {
    "url": "https://github.com/kingmap-rts/kingsmap-packages/issues"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv-cli": "^7.4.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "lerna": "^8.1.9",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "yarn@4.9.2"
}
