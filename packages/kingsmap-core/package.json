{
  "name": "@kingmap-rts/kingsmap-core",
  "version": "0.16.0",
  "description": "Deterministic simulation of King's Map (lockstep): the same seed and intents give the same world in the browser and on the server",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "sideEffects": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('./lib',{recursive:true,force:true})\"",
    "build": "yarn clean && tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "yarn build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kingmap-rts/kingsmap-packages",
    "directory": "packages/kingsmap-core"
  },
  "license": "UNLICENSED",
  "keywords": [
    "simulation",
    "lockstep",
    "game",
    "kingsmap"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "dependencies": {
    "@kingmap-rts/kingsmap-protocol": "workspace:^",
    "@kingmap-rts/kingsmap-types": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
