{
  "name": "@kingmap-rts/kingsmap-types",
  "version": "0.11.0",
  "description": "Every type and shared constant of King's Map: game vocabulary, intents, messages, world, rule shapes, WebSocket protocol, match statistics and the backend HTTP API",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('./lib',{recursive:true,force:true})\"",
    "build": "yarn clean && tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "prepack": "yarn build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kingmap-rts/kingsmap-packages",
    "directory": "packages/kingsmap-types"
  },
  "license": "UNLICENSED",
  "keywords": [
    "types",
    "kingsmap"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
